# Edite o .env e salve: o bot reinicia sozinho (npm run bot).
# Não coloque comentários na mesma linha do valor.

# Renda fixa (relatório). CDI = SELIC_ANUAL - CDI_SPREAD
SELIC_ANUAL=13.75
CDI_SPREAD=0.10
PERCENTUAL_CDI=100

# Relatório semanal (RELATORIO_DIA: 0=domingo ... 6=sábado)
RELATORIO_DIA=0
RELATORIO_HORA=8
RELATORIO_LIMITE_HORA=12
INTERVALO_ENVIO_MS=3000

# Extrato
EXTRATO_PADRAO=10
EXTRATO_MAXIMO=50

# Fuso horário (Brasília, sem horário de verão)
FUSO=America/Sao_Paulo
FUSO_OFFSET_HORAS=-3
